{
  "name": "chess-com-puter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "prebuild": "npm test",
    "build": "node build.js",
    "watch": "node build.js --watch",
    "test": "node --import ./test/support/register.mjs --test test/*.test.js",
    "test:e2e": "node build.js && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "postinstall": "node scripts/copy-stockfish.js"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.5.0",
    "@lichess-org/stockfish-web": "^0.5.0",
    "chessops": "^0.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "stylelint": "^18.0.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-order": "^8.1.3"
  }
}
